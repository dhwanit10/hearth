# ---------------------------------------------------------------------------
# Hearth backend configuration
# Copy this file to `.env` and fill in your own values.
# ---------------------------------------------------------------------------

# Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Leave empty to run the app in "demo mode": replies are streamed from a small
# built-in offline engine so you can still try the whole UI and protocol.
GEMINI_API_KEY=

# Which Gemini model to talk to.
#   gemini-3.8-flash        - newest stable Flash, best quality (default)
#   gemini-3.5-flash-lite   - fastest / cheapest, great for chat
#   gemini-3.1-flash-lite   - frontier quality at low cost
GEMINI_MODEL=gemini-3.8-flash

# Thinking budget for Gemini 3 models. Lower = snappier replies in chat.
# One of: minimal, low, medium, high. Leave empty to use the model default.
# If the configured model rejects this setting, the backend automatically
# retries the request without it.
GEMINI_THINKING_LEVEL=low

# Hard ceiling on generated tokens per reply.
GEMINI_MAX_OUTPUT_TOKENS=1024

# How many previous messages are replayed to the model as context.
CHAT_HISTORY_LIMIT=24

# SQLite database file. Relative paths are resolved inside the backend/ folder.
DATABASE_PATH=data/hearth.db

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host / port for `python -m app` style runs (see README).
HOST=127.0.0.1
PORT=8000
