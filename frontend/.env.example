# ---------------------------------------------------------------------------
# Hearth frontend configuration (optional - the defaults work with `npm run dev`)
# ---------------------------------------------------------------------------

# Base URL of the backend REST API. Leave empty to use the Vite dev proxy
# (recommended in development, see vite.config.js).
VITE_API_BASE=

# Websocket base URL. Leave empty to derive it from the current page origin.
# Set this when the UI and API are served from different hosts, e.g.
# VITE_WS_BASE=wss://api.example.com
VITE_WS_BASE=

# Only used by `vite dev` to know where to forward /api and /ws.
VITE_PROXY_TARGET=http://127.0.0.1:8000
